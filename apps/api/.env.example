# Copy to .env (not versioned) and fill in. Read by app/shared/config.py from apps/api.
DATABASE_URL=postgresql+psycopg://club:club@localhost:5432/club
FIREBASE_PROJECT_ID=demo-clubnahuelmosse
# The Firebase project web key; not needed with the Auth emulator.
FIREBASE_API_KEY=
# The service account JSON on one line; only for platforms without files.
FIREBASE_CREDENTIALS_JSON=
# The public address of this API: the links in emails point there.
PUBLIC_URL=http://localhost:8000
# smtp or brevo in production; outbox only for development.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=
# Seconds between reminder sweeps; 0 turns them off.
REMINDERS_EVERY=30

# These are read only from the process environment, not from .env:
#   FIREBASE_AUTH_EMULATOR_HOST        host:port of the Auth emulator
#   GOOGLE_APPLICATION_CREDENTIALS     path to the service account (required in production)
#   ADMIN_PASSWORD                     password of the administrator the seed command creates
#   TEST_DATABASE_URL                  database of the tests, with a name ending in _test
