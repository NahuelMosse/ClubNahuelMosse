# Copiar a .env (no se versiona) y completar. Lo lee app/config.py desde apps/api.
DATABASE_URL=postgresql+psycopg://club:club@localhost:5432/club
FIREBASE_PROJECT_ID=demo-clubnahuelmosse
# Clave web del proyecto de Firebase; no hace falta con el emulador de Auth.
FIREBASE_API_KEY=
# Contenido del JSON de la cuenta de servicio, en una sola línea; sólo para plataformas sin archivos.
FIREBASE_CREDENCIALES_JSON=
# Dirección pública de esta API: los enlaces de los correos apuntan ahí.
URL_PUBLICA=http://localhost:8000
# smtp en producción; buzon sólo para desarrollo.
CORREO_MODO=buzon
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=
# Segundos entre barridos de recordatorios; 0 los apaga.
RECORDATORIOS_CADA=30

# Estas se leen sólo del entorno del proceso, no del .env:
#   FIREBASE_AUTH_EMULATOR_HOST        host:puerto del emulador de Auth
#   GOOGLE_APPLICATION_CREDENTIALS     ruta a la cuenta de servicio (obligatoria en producción)
#   ADMIN_PASSWORD                 contraseña del administrador que siembra el comando
#   TEST_DATABASE_URL                  base de los tests, con nombre terminado en _test
