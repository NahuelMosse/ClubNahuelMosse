      "files": [".claude/steps/m-data.md", ".claude/reference/database.md", ".claude/tools/checks/data.mjs"],
      "criteria": ["P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12", "P13", "P14", "P16", "S20", "D11"],
      "items": ["Q7", "Q19", "R5", "R6"],
      "cost": { "tokensPerCard": "3000-5000", "minutesPerCard": "5-15", "idleTokens": 200, "measured": false }
    },
    "infra": {
      "version": "1.0.0", "core": "^3", "requires": [], "with": ["data"], "signals": ["infra", "cloud-dependency"],
      "does": "infrastructure: cost model, system design, queues, deployment, rollback",
      "grades": { "poc": "off", "mvp": "off" }, "gradeNote": "the cost model, system design, queues and rollback are production work",
      "files": [".claude/steps/m-infra.md", ".claude/reference/infrastructure.md", ".claude/templates/infra-cost.md", ".claude/templates/runbook.md", ".claude/tools/checks/infra.mjs"],
